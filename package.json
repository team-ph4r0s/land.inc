{
  "name": "land-inc",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "daemon": "npm run start -w @land/daemon",
    "office": "npm run dev -w @land/office",
    "build": "npm run build -w @land/office",
    "typecheck": "tsc -p apps/daemon && tsc -p apps/office",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=2 \"apps/daemon/src/**/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
